{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "开发空间",
  "version": "0.1.0",
  "identifier": "local.k3s.platform",
  "build": {"frontendDist": "../../web/dist", "devUrl": "http://localhost:5173"},
  "app": {
    "windows": [{"label": "main", "title": "开发空间", "width": 1200, "height": 800}],
    "security": {"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"}
  },
  "bundle": {"active": true, "externalBin": ["binaries/platform-sidecar"]}
}
