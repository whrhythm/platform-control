# Same locked backend and locally compiled React UI; avoids transferring base
# image layers over a slow VPN when the destination already caches Python.
FROM python:3.12-slim
WORKDIR /app
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY requirements.runtime.txt ./
RUN pip install --no-cache-dir --require-hashes --index-url ${PYPI_INDEX_URL} -r requirements.runtime.txt
COPY control_plane/ ./control_plane/
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY web/dist/ ./web/dist/
RUN useradd --uid 10001 --create-home platform
ENV PLATFORM_STATIC_DIR=/app/web/dist
ENV PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8088
CMD ["python", "-m", "control_plane", "--host", "0.0.0.0", "--port", "8088"]
