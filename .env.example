PLATFORM_DATABASE_URL=sqlite:///./control-plane.db
PLATFORM_OIDC_ISSUER=https://authentik.k3s.local/application/o/platform/
PLATFORM_OIDC_JWKS_URL=https://authentik.k3s.local/application/o/platform/jwks/
PLATFORM_OIDC_AUDIENCE=replace-with-provider-client-id
PLATFORM_OIDC_CLIENT_ID=replace-with-provider-client-id
PLATFORM_OIDC_REQUIRED_SCOPE=platform-api
PLATFORM_ADMIN_GROUP=platform-admins
PLATFORM_PUBLIC_ORIGIN=http://localhost:5173
# Local acceptance only; neither setting enables or implements real payments.
PLATFORM_TEST_PAYMENTS_ENABLED=false
PLATFORM_REQUIRE_PROJECT_ENTITLEMENT=false
# PLATFORM_DATABASE_URL=postgresql+psycopg://platform_api:password@postgres-rw.postgres.svc.cluster.local/platform
# Internal CA: install it in the trust store; never disable TLS validation.
# SSL_CERT_FILE=/path/to/ca-bundle.pem

# Optional CodeChat capability routes. Match librechat.yaml codechat.capabilities.
# Enabling also requires the existing LiteLLM and workspace agent configuration.
PLATFORM_CAPABILITIES_ENABLED=false
PLATFORM_CAPABILITY_CHAT_ROUTE=codechat-chat
PLATFORM_CAPABILITY_CODING_ROUTE=codechat-coding
# Must be a real model in PLATFORM_LITELLM_MODELS; never use a route alias here.
PLATFORM_CAPABILITY_CHAT_MODEL=
## Initial settlement rule only; saved administrator policy takes precedence.
## Test configuration, not a real-time FX quotation.
PLATFORM_MODEL_SETTLEMENT_CNY_PER_USD=7.000000

# Self-service test orders; both flags must be true. No real charge occurs.
PLATFORM_CAPACITY_UPGRADES_ENABLED=false
PLATFORM_CAPACITY_RESIZE_TIMEOUT_SECONDS=900
PLATFORM_CAPACITY_FILESYSTEM_OVERHEAD_PERCENT=10
# Optional JSON plan catalog: see docs/capacity-contract.md and deployment config.
