{
  "openapi": "3.1.0",
  "info": {
    "title": "Internal workspace files",
    "description": "Service-authenticated single-volume API. The caller must verify user identity and workspace ownership before proxying. Not for direct browser access.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/usage": {
      "get": {
        "summary": "Usage",
        "operationId": "usage_v1_usage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ]
      }
    },
    "/v1/context": {
      "get": {
        "summary": "Build Context",
        "description": "Export a bounded project build context containing regular files only.",
        "operationId": "build_context_v1_context_get",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/directories": {
      "get": {
        "summary": "List Directory",
        "description": "List one directory in the pre-authorized workspace. An empty path selects its root.",
        "operationId": "list_directory_v1_directories_get",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096,
              "default": "",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid path"
          },
          "401": {
            "description": "Service authentication required"
          },
          "404": {
            "description": "Directory not found"
          },
          "503": {
            "description": "Workspace unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Directory",
        "description": "Create one directory. Parents must already exist; existing entries are never overwritten.",
        "operationId": "create_directory_v1_directories_post",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Path"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid path"
          },
          "401": {
            "description": "Service authentication required"
          },
          "404": {
            "description": "Parent directory not found"
          },
          "409": {
            "description": "Destination already exists"
          },
          "507": {
            "description": "Storage full"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/archive": {
      "get": {
        "summary": "Download Archive",
        "operationId": "download_archive_v1_archive_get",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/file": {
      "get": {
        "summary": "Read File",
        "description": "Read a regular file up to the configured per-transfer limit; responses are not cacheable.",
        "operationId": "read_file_v1_file_get",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path"
          },
          "401": {
            "description": "Service authentication required"
          },
          "404": {
            "description": "File not found"
          },
          "413": {
            "description": "Transfer limit exceeded"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Write File",
        "description": "Upload raw bytes up to the configured per-transfer limit. Existing files are preserved unless overwrite=true; concurrent overwrites are last-writer-wins.",
        "operationId": "write_file_v1_file_put",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Path"
            }
          },
          {
            "name": "overwrite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Overwrite"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 66,
              "pattern": "^(?:\"[0-9a-f]{64}\")?$",
              "default": "",
              "title": "If-Match"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid path"
          },
          "401": {
            "description": "Service authentication required"
          },
          "404": {
            "description": "Parent directory not found"
          },
          "409": {
            "description": "Destination already exists"
          },
          "413": {
            "description": "Transfer limit exceeded"
          },
          "507": {
            "description": "Storage full"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete File",
        "operationId": "delete_file_v1_file_delete",
        "security": [
          {
            "WorkspaceServiceToken": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Path"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 66,
              "maxLength": 66,
              "pattern": "^\"[0-9a-f]{64}\"$",
              "title": "If-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "WorkspaceServiceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
